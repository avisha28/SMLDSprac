import pandas as pd

# Load Penguin dataset directly from URL
url = "https://raw.githubusercontent.com/allisonhorst/palmerpenguins/master/inst/extdata/penguins.csv"

df = pd.read_csv(url)

print("Original Dataset:")
print(df.head())

# Remove missing values
df = df.dropna()

# Simple Random Sampling
simple_sample = df.sample(n=20, random_state=42)

print("\nSimple Random Sampling:")
print(simple_sample)

# Stratified Sampling
stratified_sample = df.groupby(
    'species', group_keys=False
).sample(frac=0.2, random_state=42)

print("\nStratified Sampling:")
print(stratified_sample)

# Check distribution
print("\nOriginal Species Distribution:")
print(df['species'].value_counts())

print("\nStratified Sample Distribution:")
print(stratified_sample['species'].value_counts())
