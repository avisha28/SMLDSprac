import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler


# Load data and pick two columns to cluster on
df = pd.read_csv("C:/Users/Varalakshmi/Downloads/Social_Network_Ads.csv")
X = df[["Age", "EstimatedSalary"]]

# Scale so Age and Salary count equally
X_scaled = StandardScaler().fit_transform(X)


# Fit K-Means with your chosen k
k = 3
df["Cluster"] = KMeans(n_clusters=k, n_init=10, random_state=42).fit_predict(X_scaled)

# %%
# Fit K-Means with your chosen k
k = 3
df["Cluster"] = KMeans(n_clusters=k, n_init=10, random_state=42).fit_predict(X_scaled)

# %%
# Plot the clusters
plt.scatter(df["Age"], df["EstimatedSalary"], c=df["Cluster"], cmap="viridis")
plt.xlabel("Age")
plt.ylabel("Estimated Salary")
plt.title("K-Means Clusters")
plt.show()

# %%
# See what each cluster looks like
df.groupby("Cluster")[["Age", "EstimatedSalary", "Purchased"]].mean().round(2)
